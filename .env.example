# ====================================================
# UNIFIED PROJECT CONFIGURATION (Google AI Studio)
# ====================================================

# Google Analytics 4 (Production Tracking)
VITE_GA_MEASUREMENT_ID=

# Stripe Integration (Payments & Subscriptions) - Optional
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PREMIUM_PRICE_ID=
# STRIPE_VERIFIED_PRICE_ID=
# VITE_STRIPE_PUBLISHABLE_KEY=

# Internal Services
REDIS_URL=

# Security
SESSION_SECRET=

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# To resolve "No project associated" errors, go to Project Settings -> Billing
# or use the Paid Model Flow to link a GCP project with billing enabled.
GEMINI_API_KEY="your_api_key_here"

# GIPHY_API_KEY: Required for GIF sticker tool.
# Get a free API key at https://developers.giphy.com/
GIPHY_API_KEY=

# SPOTIFY_CLIENT_ID & SPOTIFY_CLIENT_SECRET: Required for Spotify track metadata lookup
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime.
APP_URL="https://your-app-url.com"

# ====================================================
# FIREBASE CONFIGURATION
# ====================================================
# Firebase is provisioned automatically within the same GCP project.
# Configuration is managed via firebase-applet-config.json.
# Ensure your GCP project has billing enabled for Storage and Hosting.
