rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // -- PRIMITIVES --
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // -- PATHS --
    
    // Unified User Media Structure
    match /users/{userId}/{folder}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && (
        (folder == 'profile' && request.resource.size < 10 * 1024 * 1024) ||
        (folder == 'posts' && request.resource.size < 100 * 1024 * 1024) ||
        (folder == 'stories' && request.resource.size < 50 * 1024 * 1024) ||
        (folder == 'videos' && request.resource.size < 200 * 1024 * 1024) ||
        (folder == 'highlights' && request.resource.size < 50 * 1024 * 1024) ||
        (folder == 'vault' && request.resource.size < 100 * 1024 * 1024)
      );
    }
    
    // User profile avatars
    match /avatars/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && request.resource.size < 10 * 1024 * 1024;
    }
    
    // User profile photos
    match /profiles/{userId}/{filename} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024;
    }
    
    match /profiles/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && request.resource.size < 5 * 1024 * 1024;
    }
    
    // Feed posts
    match /posts/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && request.resource.size < 100 * 1024 * 1024;
    }

    // Videos
    match /videos/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && request.resource.size < 200 * 1024 * 1024;
    }

    // Stories
    match /stories/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && request.resource.size < 50 * 1024 * 1024;
    }

    // Messenger Media
    // We can't query firestore from storage easily in free tier, so we verify signed in.
    // In a real production app we might use custom claims or signed URLs to enforce participants.
    match /chats/{chatId}/{allPaths=**} {
      allow read, write: if isSignedIn();
    }
    
    // Notes
    match /notes/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }
  }
}
